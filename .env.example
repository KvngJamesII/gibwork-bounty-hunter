# Optional: Solana private key for wallet-authenticated Gibwork SDK calls
# (base58 seed/secret or JSON byte array). Never commit real keys.
# GIBWORK_PRIVATE_KEY=
# Or path to a keypair file:
# GIBWORK_KEYPAIR_PATH=~/.config/gibwork/id.json

# Use production API for @gibwork/sdk (default true)
GIBWORK_PRODUCTION=true

# Public discovery / task detail (no wallet)
# GIBWORK_EXPLORE_API_URL=https://api.gib.work
# GIBWORK_TASK_API_URL=https://gib.work/api

# Skill tags to prefer when ranking (comma-separated)
GIB_HUNT_SKILLS=development,typescript,rust,solana,cli,mcp,sdk

# Minimum USDC reward to consider
GIB_HUNT_MIN_USD=20

# Public Solana wallet address for grind-report balance check (read-only; no signing)
# GIB_HUNT_WALLET=2Uup61Xjcqpyh9jfSNKBfHr4J1Ju7qjzDyUzFpdmduwW
# Optional RPC override
# GIB_HUNT_SOLANA_RPC=https://api.mainnet-beta.solana.com
